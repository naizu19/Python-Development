<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_trip_reason_wizard_form" model="ir.ui.view">
        <field name="name">business.trip.reason.wizard.form</field>
        <field name="model">business.trip.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason / Comment">
                <group>
                    <field name="request_id" invisible="1"/>
                    <field name="action_type" invisible="1"/>
                    <field name="reason" placeholder="Please provide the reason/comment..."/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
