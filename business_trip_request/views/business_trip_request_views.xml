<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_trip_request_form" model="ir.ui.view">
        <field name="name">business.trip.request.form</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <form string="Business Trip / Assignment Request">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_resubmit" string="Move to Draft" type="object"
                            invisible="state != 'returned'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary"
                            invisible="not can_current_user_approve or state != 'pending_approval'"/>
                    <button name="action_open_reject_wizard" string="Reject" type="object"
                            invisible="not can_current_user_approve or state != 'pending_approval'"/>
                    <button name="action_open_return_wizard" string="Return for Modification" type="object"
                            invisible="not can_current_user_approve or state != 'pending_approval'"/>
                    <button name="action_calculate_allowance" string="Calculate Allowance" type="object"
                            class="btn-primary" groups="business_trip_request.group_business_trip_hr"
                            invisible="state != 'hr_review'"/>
                    <button name="action_mark_ready_for_travel" string="Mark Ready for Travel" type="object"
                            class="btn-primary" groups="business_trip_request.group_business_trip_hr"
                            invisible="state != 'allowance_calculated'"/>
                    <button name="action_start_trip" string="Start Trip" type="object"
                            class="btn-primary" invisible="state != 'ready_for_travel'"/>
                    <button name="action_end_trip" string="End Trip" type="object"
                            class="btn-primary" invisible="state != 'trip_in_progress'"/>
                    <button name="action_submit_trip_report" string="Submit Trip Report" type="object"
                            class="btn-primary" invisible="state != 'trip_report_required'"/>
                    <button name="action_approve_trip_report" string="Approve Trip Report" type="object"
                            class="btn-primary" groups="business_trip_request.group_business_trip_hr"
                            invisible="state != 'trip_report_under_approval'"/>
                    <button name="action_open_reject_report_wizard" string="Reject Trip Report" type="object"
                            groups="business_trip_request.group_business_trip_hr"
                            invisible="state != 'trip_report_under_approval'"/>
                    <button name="action_process_settlement" string="Process Settlement" type="object"
                            class="btn-primary" groups="business_trip_request.group_business_trip_finance"
                            invisible="state != 'settlement'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_approval,hr_review,ready_for_travel,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted" invisible="not current_step_name or state not in ('pending_approval',)">
                            Currently pending with: <field name="current_step_name" readonly="1" nolabel="1" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="employee_code" readonly="1"/>
                            <field name="job_title" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="direct_manager_id" readonly="1"/>
                            <field name="can_current_user_approve" invisible="1"/>
                        </group>
                        <group string="Flags">
                            <field name="is_senior_management" readonly="1"/>
                            <field name="is_frequent_traveler" readonly="1"/>
                            <field name="travel_class_id" readonly="1"/>
                            <field name="is_peak_period" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_frequent_traveler">
                        This employee is flagged as a Frequent Traveler and may be subject to
                        a fixed/permanent travel allowance instead of the standard assignment
                        allowance.
                    </div>
                    <notebook>
                        <page string="Trip Information">
                            <group>
                                <group>
                                    <field name="destination_country_id"/>
                                    <field name="destination_city_id"/>
                                    <field name="trip_type" readonly="1"/>
                                    <field name="region" invisible="trip_type != 'international'"/>
                                    <field name="distance_km" invisible="trip_type != 'domestic'"/>
                                    <field name="is_formal_assignment" readonly="1"/>
                                </group>
                                <group>
                                    <field name="date_start" readonly="state != 'draft'"/>
                                    <field name="date_end" readonly="state != 'draft'"/>
                                    <field name="overnight_stay"/>
                                    <field name="total_days" readonly="1"/>
                                    <field name="overnight_count" readonly="1"/>
                                    <field name="flight_duration_hours" invisible="trip_type != 'international'"/>
                                    <field name="extra_days" readonly="1" invisible="trip_type != 'international'"/>
                                </group>
                            </group>
                            <group>
                                <field name="purpose" placeholder="Assignment purpose..."/>
                                <field name="objectives" placeholder="Business trip objectives..."/>
                            </group>
                            <group string="Combine with Annual Leave">
                                <field name="combine_annual_leave"/>
                                <field name="leave_start_date" invisible="not combine_annual_leave"/>
                                <field name="leave_end_date" invisible="not combine_annual_leave"/>
                            </group>
                            <group string="Business Rules Validation">
                                <field name="validation_warning_ids" nolabel="1" widget="text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Travel &amp; Support Requirements">
                            <group>
                                <field name="need_flight"/>
                                <field name="need_transportation"/>
                                <field name="need_visa"/>
                                <field name="need_other"/>
                                <field name="other_specify" invisible="not need_other"/>
                            </group>
                            <group string="Cash Advance">
                                <field name="advance_required"/>
                                <field name="requested_advance" invisible="not advance_required"/>
                                <field name="payment_timing"/>
                            </group>
                        </page>
                        <page string="Approval Workflow">
                            <field name="approval_line_ids" readonly="1">
                                <tree decoration-success="state == 'approved'"
                                      decoration-danger="state == 'rejected'"
                                      decoration-warning="state == 'returned'">
                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="approver_id"/>
                                    <field name="approver_group_id"/>
                                    <field name="approved_by"/>
                                    <field name="state" widget="badge"/>
                                    <field name="date"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                            <group>
                                <field name="rejection_reason" invisible="state != 'rejected'"/>
                                <field name="return_comment" invisible="state != 'returned'"/>
                            </group>
                        </page>
                        <page string="HR Allowance Calculation"
                              groups="business_trip_request.group_business_trip_hr,business_trip_request.group_business_trip_finance">
                            <group>
                                <group>
                                    <field name="basic_salary"/>
                                    <field name="applicable_rate" readonly="1"/>
                                    <field name="base_daily_allowance" readonly="1"/>
                                    <field name="eligible_days" readonly="1"/>
                                    <field name="overnight_factor" readonly="1"/>
                                    <field name="gross_allowance" readonly="1"/>
                                </group>
                                <group>
                                    <field name="accommodation_amount" readonly="1"/>
                                    <field name="transportation_amount" readonly="1"/>
                                    <field name="food_amount" readonly="1"/>
                                    <field name="misc_allowance_amount" readonly="1"/>
                                    <field name="transportation_deduction" readonly="1"/>
                                    <field name="net_allowance" readonly="1"/>
                                </group>
                            </group>
                            <group string="Short Domestic Trip" invisible="is_formal_assignment">
                                <field name="short_trip_daily_amount" readonly="1"/>
                                <field name="accommodation_actual_cost"/>
                            </group>
                        </page>
                        <page string="Trip Report" invisible="state in ('draft','pending_approval','hr_review','allowance_calculated','ready_for_travel','trip_in_progress')">
                            <group>
                                <group>
                                    <field name="actual_date_start"/>
                                    <field name="actual_date_end"/>
                                    <field name="actual_overnight_count"/>
                                    <field name="actual_days" readonly="1"/>
                                    <field name="days_difference" readonly="1"/>
                                    <field name="report_state" readonly="1"/>
                                </group>
                                <group>
                                    <field name="additional_days"/>
                                    <field name="additional_days_justification" invisible="not additional_days"/>
                                </group>
                            </group>
                            <group>
                                <field name="work_summary"/>
                                <field name="objectives_achieved"/>
                                <field name="report_notes"/>
                            </group>
                        </page>
                        <page string="Settlement" invisible="state not in ('settlement','completed')"
                              groups="business_trip_request.group_business_trip_hr,business_trip_request.group_business_trip_finance">
                            <group>
                                <field name="settlement_state" readonly="1"/>
                                <field name="settlement_date" readonly="1"/>
                                <field name="settlement_amount" readonly="1"/>
                                <field name="processed_by" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_business_trip_request_tree" model="ir.ui.view">
        <field name="name">business.trip.request.tree</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'rejected'" decoration-warning="state == 'returned'"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination_city_id"/>
                <field name="trip_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"/>
                <field name="net_allowance" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_business_trip_request_kanban" model="ir.ui.view">
        <field name="name">business.trip.request.kanban</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_kanban_small_column">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination_city_id"/>
                <field name="trip_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="net_allowance"/>
                <field name="currency_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <strong><field name="name"/></strong>
                                    <span t-if="record.trip_type.raw_value == 'international'"
                                          class="float-end badge text-bg-info">International</span>
                                    <span t-if="record.trip_type.raw_value == 'domestic'"
                                          class="float-end badge text-bg-secondary">Domestic</span>
                                </div>
                                <div class="mt-1">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                </div>
                                <div class="text-muted">
                                    <field name="destination_city_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="date_start"/> → <field name="date_end"/>
                                </div>
                                <div class="mt-1">
                                    <strong><field name="net_allowance" widget="monetary"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_business_trip_request_pivot" model="ir.ui.view">
        <field name="name">business.trip.request.pivot</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <pivot string="Business Trip Requests">
                <field name="state" type="row"/>
                <field name="trip_type" type="col"/>
                <field name="net_allowance" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_business_trip_request_graph" model="ir.ui.view">
        <field name="name">business.trip.request.graph</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <graph string="Business Trip Requests" type="bar">
                <field name="state"/>
                <field name="net_allowance" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_business_trip_request_search" model="ir.ui.view">
        <field name="name">business.trip.request.search</field>
        <field name="model">business.trip.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="destination_city_id"/>
                <filter string="My Requests" name="my_requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="Pending My Approval" name="pending_my_approval"
                        domain="[('state', '=', 'pending_approval'), ('approval_line_ids.approver_id', '=', uid)]"/>
                <separator/>
                <filter string="Domestic" name="domestic" domain="[('trip_type', '=', 'domestic')]"/>
                <filter string="International" name="international" domain="[('trip_type', '=', 'international')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending_approval"
                        domain="[('state', '=', 'pending_approval')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Trip Type" name="group_trip_type" context="{'group_by': 'trip_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_business_trip_request" model="ir.actions.act_window">
        <field name="name">Business Trip / Assignment Requests</field>
        <field name="res_model">business.trip.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Business Trip / Assignment Request
            </p>
        </field>
    </record>

    <record id="action_business_trip_request_hr" model="ir.actions.act_window">
        <field name="name">All Business Trip Requests (HR)</field>
        <field name="res_model">business.trip.request</field>
        <field name="view_mode">kanban,tree,form,pivot,graph</field>
    </record>
</odoo>
