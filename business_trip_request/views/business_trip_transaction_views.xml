<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_trip_transaction_form" model="ir.ui.view">
        <field name="name">business.trip.transaction.form</field>
        <field name="model">business.trip.transaction</field>
        <field name="arch" type="xml">
            <form string="Business Trip Transaction">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="request_id"/></h1>
                    </div>
                    <group>
                        <group string="Transaction">
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="date"/>
                            <field name="processed_by"/>
                            <field name="note"/>
                        </group>
                        <group string="Employee">
                            <field name="employee_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Trip Details">
                        <group>
                            <field name="destination_city" readonly="1"/>
                            <field name="destination_country_id" readonly="1"/>
                            <field name="trip_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="total_days" readonly="1"/>
                        </group>
                    </group>
                    <group string="Allowance Detail">
                        <group>
                            <field name="basic_salary" readonly="1"/>
                            <field name="applicable_rate" readonly="1"/>
                            <field name="gross_allowance" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_advance" readonly="1"/>
                            <field name="net_allowance" readonly="1"/>
                            <field name="settlement_amount" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_business_trip_transaction_tree" model="ir.ui.view">
        <field name="name">business.trip.transaction.tree</field>
        <field name="model">business.trip.transaction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="request_id"/>
                <field name="employee_id"/>
                <field name="destination_city"/>
                <field name="trip_type"/>
                <field name="transaction_type"/>
                <field name="amount" sum="Total"/>
                <field name="processed_by"/>
            </tree>
        </field>
    </record>

    <record id="view_business_trip_transaction_search" model="ir.ui.view">
        <field name="name">business.trip.transaction.search</field>
        <field name="model">business.trip.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="request_id"/>
                <field name="employee_id"/>
                <field name="destination_city"/>
                <filter string="Advance Payment" name="advance_payment" domain="[('transaction_type', '=', 'advance_payment')]"/>
                <filter string="Settlement" name="settlement" domain="[('transaction_type', '=', 'settlement')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'transaction_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_business_trip_transaction" model="ir.actions.act_window">
        <field name="name">Transaction History</field>
        <field name="res_model">business.trip.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transactions recorded yet.
            </p>
            <p>
                Transactions are created automatically when Finance processes a
                settlement, or you can record one manually with New.
            </p>
        </field>
    </record>
</odoo>
