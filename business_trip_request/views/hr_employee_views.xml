<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_business_trip" model="ir.ui.view">
        <field name="name">hr.employee.form.business.trip</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Business Trip Settings" name="business_trip_settings">
                    <group>
                        <field name="is_senior_management"/>
                        <field name="frequent_traveler"/>
                        <field name="travel_class_id"/>
                        <field name="domestic_days_ytd" readonly="1"/>
                        <field name="international_days_ytd" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
