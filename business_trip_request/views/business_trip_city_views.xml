<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_trip_city_tree" model="ir.ui.view">
        <field name="name">business.trip.city.tree</field>
        <field name="model">business.trip.city</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="country_id"/>
                <field name="is_peak_city" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_business_trip_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">business.trip.city</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a destination city and mark it as a Peak Period city if applicable.
            </p>
        </field>
    </record>
</odoo>
