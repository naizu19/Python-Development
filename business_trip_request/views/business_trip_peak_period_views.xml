<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_business_trip_peak_period_tree" model="ir.ui.view">
        <field name="name">business.trip.peak.period.tree</field>
        <field name="model">business.trip.peak.period</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </tree>
        </field>
    </record>

    <record id="action_business_trip_peak_period" model="ir.actions.act_window">
        <field name="name">Peak Periods</field>
        <field name="res_model">business.trip.peak.period</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define peak-period date ranges (e.g. Eid holiday weeks).
                Summer months (June-August) are detected automatically.
            </p>
        </field>
    </record>
</odoo>
