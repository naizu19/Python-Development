<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_business_trip" model="ir.module.category">
        <field name="name">Business Trip</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_business_trip_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_business_trip"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_business_trip_hr" model="res.groups">
        <field name="name">HR Officer</field>
        <field name="category_id" ref="module_category_business_trip"/>
        <field name="implied_ids" eval="[(4, ref('group_business_trip_user'))]"/>
    </record>

    <record id="group_business_trip_finance" model="res.groups">
        <field name="name">Finance Officer</field>
        <field name="category_id" ref="module_category_business_trip"/>
        <field name="implied_ids" eval="[(4, ref('group_business_trip_user'))]"/>
    </record>

    <record id="group_business_trip_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="category_id" ref="module_category_business_trip"/>
        <field name="implied_ids" eval="[(4, ref('group_business_trip_user'))]"/>
    </record>

    <record id="rule_business_trip_request_own_or_approver" model="ir.rule">
        <field name="name">Business Trip Request: own or approver</field>
        <field name="model_id" ref="model_business_trip_request"/>
        <field name="groups" eval="[(4, ref('group_business_trip_user'))]"/>
        <field name="domain_force">[
            '|', '|',
            ('employee_id.user_id', '=', user.id),
            ('approval_line_ids.approver_id', '=', user.id),
            ('approval_line_ids.approver_group_id', 'in', user.groups_id.ids),
        ]</field>
    </record>

    <record id="rule_business_trip_request_hr_full" model="ir.rule">
        <field name="name">Business Trip Request: HR full access</field>
        <field name="model_id" ref="model_business_trip_request"/>
        <field name="groups" eval="[(4, ref('group_business_trip_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_business_trip_request_finance_full" model="ir.rule">
        <field name="name">Business Trip Request: Finance full access</field>
        <field name="model_id" ref="model_business_trip_request"/>
        <field name="groups" eval="[(4, ref('group_business_trip_finance'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_business_trip_request_ceo_full" model="ir.rule">
        <field name="name">Business Trip Request: CEO full access</field>
        <field name="model_id" ref="model_business_trip_request"/>
        <field name="groups" eval="[(4, ref('group_business_trip_ceo'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_business_trip_approval_line_own_or_approver" model="ir.rule">
        <field name="name">Business Trip Approval Line: own or approver</field>
        <field name="model_id" ref="model_business_trip_approval_line"/>
        <field name="groups" eval="[(4, ref('group_business_trip_user'))]"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('request_id.employee_id.user_id', '=', user.id),
            ('approver_id', '=', user.id),
            ('approver_group_id', 'in', user.groups_id.ids),
            ('request_id.approval_line_ids.approver_group_id', 'in', user.groups_id.ids),
        ]</field>
    </record>

    <record id="rule_business_trip_approval_line_hr_full" model="ir.rule">
        <field name="name">Business Trip Approval Line: HR full access</field>
        <field name="model_id" ref="model_business_trip_approval_line"/>
        <field name="groups" eval="[(4, ref('group_business_trip_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
