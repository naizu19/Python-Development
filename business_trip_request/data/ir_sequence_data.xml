<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_business_trip_request" model="ir.sequence">
        <field name="name">Business Trip Request</field>
        <field name="code">business.trip.request</field>
        <field name="prefix">BT-%(year)s%(month)s%(day)s-</field>
