<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_step_direct_manager" model="business.trip.approval.step">
        <field name="name">Direct Manager</field>
        <field name="sequence">10</field>
        <field name="source">employee_manager</field>
    </record>

    <record id="approval_step_department_manager" model="business.trip.approval.step">
        <field name="name">Department Manager</field>
        <field name="sequence">20</field>
        <field name="source">department_manager</field>
    </record>

    <record id="approval_step_ceo" model="business.trip.approval.step">
        <field name="name">CEO</field>
        <field name="sequence">30</field>
        <field name="source">ceo</field>
    </record>

    <!-- HR Review is no longer a manual approval step: after CEO approval
         the request is routed to HR automatically (state -> hr_review).
         This removes the step for databases upgrading from an earlier
         version where it existed as a 4th approval step. -->
    <delete model="business.trip.approval.step" id="approval_step_hr"/>
</odoo>
